---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "LoveHouse Official CLT — House Music Rooted in the Underground",
  description = "LoveHouse Official CLT is Charlotte's home for soulful & deep house — underground events, mixes, culture, and DJ bookings.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Analytics />
    <script is:inline>
      const postWalterPath = () =>
        window.parent?.postMessage(
          { type: "walter:navigation", path: location.pathname + location.search },
          "*",
        );
      document.addEventListener("astro:page-load", postWalterPath);
      window.addEventListener("load", postWalterPath);
    </script>
  </head>
  <body class="m-0 flex min-h-screen w-full flex-col bg-ink text-offwhite">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
