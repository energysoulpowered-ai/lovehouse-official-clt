---
import Layout from "../layouts/Layout.astro";
import { Disc3, CalendarHeart, Radio, HeartHandshake, ArrowRight, Calendar, MapPin, Clock, Download } from "@lucide/astro";

const highlights = [
  {
    icon: Disc3,
    title: "The Sound",
    body: "Soulful, deep, and unmistakably underground. Curated mixes and releases straight from the heart of the floor.",
  },
  {
    icon: CalendarHeart,
    title: "The Parties",
    body: "Underground music, community, and a room full of people who get it. Charlotte nights built on real house music.",
  },
  {
    icon: Radio,
    title: "The Culture",
    body: "News, stories, and the artists moving the scene forward. House isn't just music here — it's a way of moving.",
  },
  {
    icon: HeartHandshake,
    title: "The Community",
    body: "No egos, no velvet ropes. Just love for the record and the people you share it with. Everyone's welcome.",
  },
];
---

<Layout>
  <!-- DOWNLOAD BAR -->
  <div class="border-b border-white/10 bg-ink-soft">
    <div class="mx-auto flex max-w-7xl items-center justify-center px-6 py-3 sm:px-10">
      <a
        href="/download"
        class="inline-flex items-center gap-2 font-display text-xs font-bold uppercase tracking-widest text-offwhite/80 transition-colors hover:text-red"
      >
        <Download size={14} />
        Download Site Code
      </a>
    </div>
  </div>

  <!-- HERO -->
  <section class="relative isolate overflow-hidden">
    <img
      src="/images/dj-hero.webp"
      alt="DJ performing under neon club lights"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-ink/95 via-crimson/50 to-violet/40"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/40 to-transparent"
    >
    </div>

    <div class="mx-auto flex max-w-7xl flex-col items-start px-6 py-28 sm:px-10 md:py-40">
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-red/40 bg-red/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-red"
      >
        Charlotte · NC
      </span>
      <h1
        class="max-w-4xl font-display text-5xl font-black uppercase leading-[0.92] tracking-tight drop-shadow-[0_4px_30px_rgba(230,20,43,0.35)] sm:text-7xl md:text-8xl"
      >
        House music rooted in the <span class="text-red">underground</span>
      </h1>
      <p class="mt-8 max-w-xl text-lg leading-relaxed text-offwhite/85 sm:text-xl">
        LoveHouse Official CLT is where soulful and deep house lives — the
        parties, the mixes, and the people who love the dance floor as much as
        we do.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="/events"
          class="group inline-flex items-center gap-2 rounded-full bg-red px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-offwhite transition-transform hover:scale-[1.03] hover:bg-red/90"
        >
          Join the party
          <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href="/music"
          class="inline-flex items-center gap-2 rounded-full border border-white/25 px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-offwhite transition-colors hover:border-magenta hover:text-magenta"
        >
          Hear the sound
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED EVENT -->
  <section class="relative overflow-hidden bg-gradient-to-br from-red/80 to-magenta/60 px-6 py-20 sm:px-10 sm:py-28">
    <div class="mx-auto max-w-4xl text-center">
      <span class="inline-block rounded-full bg-white/20 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-offwhite backdrop-blur-sm">
        Coming Up Next
      </span>
      <h2 class="mt-6 font-display text-4xl font-black uppercase tracking-tight text-offwhite sm:text-5xl md:text-6xl">
        LoveHouse
      </h2>
      <p class="mt-4 text-lg font-medium text-offwhite/90 sm:text-xl">
        Featuring John Crockett, Wil Milton &amp; DJ Q-INETIC
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4 text-sm font-bold uppercase tracking-widest text-offwhite/80">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur-sm">
          <Calendar size={16} class="text-offwhite" />
          August 15
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur-sm">
          <MapPin size={16} class="text-offwhite" />
          Crown Station
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 backdrop-blur-sm">
          <Clock size={16} class="text-offwhite" />
          3PM – 8PM
        </span>
      </div>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="https://events.ticketleap.com/tickets/powered-by-energy-soul/lovehouse-clt-210208621"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-offwhite px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-ink transition-transform hover:scale-[1.03]"
        >
          Get Tickets
          <ArrowRight size={16} />
        </a>
        <a
          href="/music"
          class="inline-flex items-center gap-2 rounded-full border border-white/30 px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-offwhite transition-all hover:bg-white/10"
        >
          Hear the Lineup
        </a>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="mx-auto max-w-7xl px-6 py-24 sm:px-10">
    <div class="max-w-2xl">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">
        More than a <span class="text-magenta">night out</span>
      </h2>
      <p class="mt-4 text-lg text-ash">
        Four things we care about, every single time the lights go down.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        highlights.map((h) => (
          <div class="group rounded-2xl border border-white/10 bg-ink-soft p-7 transition-colors hover:border-red/50">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red/15 text-red transition-colors group-hover:bg-red group-hover:text-offwhite">
              <h.icon size={24} />
            </div>
            <h3 class="mt-6 font-display text-xl font-bold uppercase tracking-wide">
              {h.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ash">{h.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FEATURE BAND -->
  <section class="relative isolate overflow-hidden">
    <img
      src="/images/crowd.webp"
      alt="Crowd dancing under neon lights"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 -z-10 bg-ink/80"></div>
    <div class="mx-auto max-w-4xl px-6 py-28 text-center sm:px-10">
      <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-magenta">
        No egos · No velvet ropes
      </p>
      <h2 class="mt-5 font-display text-4xl font-black uppercase leading-tight tracking-tight sm:text-6xl">
        Come as you are.<br />Let the music move you and get into your groove.
      </h2>
      <a
        href="/events"
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-offwhite px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-ink transition-transform hover:scale-[1.03]"
      >
        See what's next
        <ArrowRight size={18} />
      </a>
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section class="mx-auto max-w-4xl px-6 py-24 text-center sm:px-10">
    <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight sm:text-5xl">
      Get on the <span class="text-red">list</span>
    </h2>
    <p class="mx-auto mt-4 max-w-lg text-lg text-ash">
      Early tickets, new mixes, and the next drop — straight to your inbox. No
      spam, just the good stuff.
    </p>
    <form class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row" action="/contact">
      <input
        type="email"
        name="email"
        required
        placeholder="you@email.com"
        class="w-full rounded-full border border-white/15 bg-ink-soft px-6 py-4 text-sm text-offwhite placeholder:text-ash focus:border-red focus:outline-none"
      />
      <button
        type="submit"
        class="rounded-full bg-red px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-offwhite transition-transform hover:scale-[1.03]"
      >
        Subscribe
      </button>
    </form>
  </section>
</Layout>
