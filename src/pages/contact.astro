---
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { Mail, Music4, Megaphone } from "@lucide/astro";

const reasons = [
  { icon: Music4, title: "Book a DJ", body: "Venues, festivals, private events — bring the sound to your floor." },
  { icon: Megaphone, title: "Play with us", body: "Send a mix and introduce yourself. We're always listening." },
  { icon: Mail, title: "Just say hi", body: "Questions, love, or collaboration ideas — the door's open." },
];
---

<Layout
  title="Contact — LoveHouse Official CLT"
  description="Get in touch with LoveHouse Official CLT — DJ bookings, demos, collaborations, and joining the Charlotte house-music community."
>
  <section class="border-b border-white/10 bg-gradient-to-b from-crimson/25 to-ink">
    <div class="mx-auto max-w-7xl px-6 py-24 sm:px-10 md:py-28">
      <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-magenta">
        Say Hello
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-5xl font-black uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Let's make some <span class="text-red">noise</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-offwhite/85">
        Booking, demos, or just love for the scene — reach out and we'll get back
        to you.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 sm:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {
        reasons.map((r) => (
          <div class="rounded-2xl border border-white/10 bg-ink-soft p-8">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-red/15 text-red">
              <r.icon size={24} />
            </div>
            <h3 class="mt-6 font-display text-xl font-bold uppercase tracking-wide">{r.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ash">{r.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <!-- FORM -->
      <form class="rounded-3xl border border-white/10 bg-ink-soft p-8 sm:p-10">
        <h2 class="font-display text-2xl font-bold uppercase tracking-tight">Send a message</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-2 text-sm">
            <span class="font-semibold uppercase tracking-wide text-ash">Name</span>
            <input
              type="text"
              name="name"
              required
              class="rounded-xl border border-white/15 bg-ink px-4 py-3 text-offwhite placeholder:text-ash focus:border-red focus:outline-none"
              placeholder="Your name"
            />
          </label>
          <label class="flex flex-col gap-2 text-sm">
            <span class="font-semibold uppercase tracking-wide text-ash">Email</span>
            <input
              type="email"
              name="email"
              required
              class="rounded-xl border border-white/15 bg-ink px-4 py-3 text-offwhite placeholder:text-ash focus:border-red focus:outline-none"
              placeholder="you@email.com"
            />
          </label>
        </div>
        <label class="mt-5 flex flex-col gap-2 text-sm">
          <span class="font-semibold uppercase tracking-wide text-ash">Message</span>
          <textarea
            name="message"
            rows="5"
            required
            class="rounded-xl border border-white/15 bg-ink px-4 py-3 text-offwhite placeholder:text-ash focus:border-red focus:outline-none"
            placeholder="Tell us about the event, the vibe, or just say hi…"></textarea>
        </label>
        <button
          type="submit"
          class="mt-6 w-full rounded-full bg-red px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-offwhite transition-transform hover:scale-[1.02] sm:w-auto"
        >
          Send it
        </button>
      </form>

      <!-- SIDE -->
      <div class="flex flex-col gap-6">
        <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-violet/25 to-crimson/25 p-8">
          <h3 class="font-display text-xl font-bold uppercase tracking-wide">Join the party</h3>
          <p class="mt-2 text-sm text-ash">
            Get early tickets and new mixes before anyone else.
          </p>
          <form class="mt-5 flex flex-col gap-3">
            <input
              type="email"
              name="email"
              required
              placeholder="you@email.com"
              class="w-full rounded-full border border-white/15 bg-ink px-5 py-3 text-sm text-offwhite placeholder:text-ash focus:border-red focus:outline-none"
            />
            <button
              type="submit"
              class="rounded-full bg-offwhite px-6 py-3 font-display text-sm font-bold uppercase tracking-widest text-ink transition-transform hover:scale-[1.02]"
            >
              Subscribe
            </button>
          </form>
        </div>

        <a
          href="https://instagram.com/lovehouseofficialclt"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-4 rounded-3xl border border-white/10 bg-ink-soft p-8 transition-colors hover:border-magenta"
        >
          <SocialIcon name="instagram" size={32} brand title="Instagram" />
          <div>
            <p class="font-display text-lg font-bold uppercase tracking-wide">Follow along</p>
            <p class="text-sm text-ash">@lovehouseofficialclt</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
