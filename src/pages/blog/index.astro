---
import Layout from "../../layouts/Layout.astro";
import { getPosts, formatDate } from "../../lib/blog";
import { ArrowUpRight } from "@lucide/astro";

const posts = await getPosts();
---

<Layout
  title="Blog — News & Culture — LoveHouse Official CLT"
  description="News, stories, and culture from LoveHouse Official CLT — the artists and sounds moving Charlotte's underground house scene."
>
  <section class="border-b border-white/10 bg-gradient-to-b from-crimson/25 to-ink">
    <div class="mx-auto max-w-7xl px-6 py-24 sm:px-10 md:py-28">
      <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-magenta">
        News & Culture
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-5xl font-black uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Stories from the <span class="text-red">floor</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-offwhite/85">
        The artists, records, and moments shaping Charlotte's underground.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 sm:px-10">
    {
      posts.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-white/15 bg-ink-soft p-16 text-center">
          <h2 class="font-display text-2xl font-bold uppercase tracking-tight">
            Posts coming soon
          </h2>
          <p class="mt-3 text-ash">Penny will publish them here. Check back shortly.</p>
        </div>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => {
            const thumb = post.mediaUrls?.[0];
            const date = formatDate(post.dateScheduled);
            return (
              <a
                href={`/blog/${post.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-ink-soft transition-colors hover:border-red/50"
              >
                {thumb ? (
                  <img
                    src={thumb}
                    alt={post.title}
                    class="aspect-[16/10] w-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="aspect-[16/10] w-full bg-gradient-to-br from-crimson/40 via-ink to-violet/40" />
                )}
                <div class="flex flex-1 flex-col p-6">
                  {date && (
                    <span class="text-xs font-semibold uppercase tracking-widest text-magenta">
                      {date}
                    </span>
                  )}
                  <h3 class="mt-2 font-display text-xl font-bold uppercase leading-tight tracking-tight">
                    {post.title}
                  </h3>
                  <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-red">
                    Read more
                    <ArrowUpRight size={16} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</Layout>
