---
import Layout from "../layouts/Layout.astro";
import { MapPin, Clock, Ticket, ArrowRight, BellRing } from "@lucide/astro";

const events = [
  {
    day: "15",
    month: "AUG",
    title: "LoveHouse",
    venue: "Crown Station · Charlotte, NC",
    time: "3:00 PM – 8:00 PM",
    tag: "House",
    subtitle: "Featuring resident John Crockett, Wil Milton & DJ Q-INETIC",
    featuredArtists: ["John Crockett", "Wil Milton", "DJ Q-INETIC"],
    status: "On sale",
  },
  {
    day: "19",
    month: "SEP",
    title: "Soulful September 19th",
    time: "9:00 PM – Late",
    tag: "Special",
    status: "TBD",
  },
  {
    day: "17",
    month: "OCT",
    title: "October Deep Fest",
    time: "9:00 PM – Late",
    tag: "Special",
    status: "TBD",
  },
];
---

<Layout
  title="Events — LoveHouse Official CLT"
  description="Upcoming LoveHouse Official CLT events in Charlotte — underground house-music parties, rooftop sessions, and late nights."
>
  <!-- HEADER -->
  <section class="relative isolate overflow-hidden border-b border-white/10">
    <img
      src="/images/crowd.webp"
      alt="Crowd at a house-music party"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/80 to-ink/50"></div>
    <div class="mx-auto max-w-7xl px-6 py-28 sm:px-10 md:py-36">
      <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-magenta">
        The Parties
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-5xl font-black uppercase leading-[0.95] tracking-tight sm:text-7xl">
        Where Charlotte comes to <span class="text-red">dance</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-offwhite/85">
        Loud systems, low ceilings, and a room full of people who get it. Here's
        where we'll be next.
      </p>
    </div>
  </section>

  <!-- EVENT LIST -->
  <section class="mx-auto max-w-5xl px-6 py-24 sm:px-10">
    <div class="space-y-5">
      {
        events.map((e) => (
          <div class="grid grid-cols-1 gap-6 rounded-2xl border border-white/10 bg-ink-soft p-6 transition-colors hover:border-red/50 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-8">
            <div class="flex w-20 flex-col items-center justify-center rounded-xl bg-red/15 py-4 text-red">
              <span class="font-display text-3xl font-black leading-none">{e.day}</span>
              <span class="mt-1 text-xs font-bold uppercase tracking-widest">{e.month}</span>
            </div>
            <div>
              <span class="inline-block rounded-full bg-magenta/15 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-magenta">
                {e.tag}
              </span>
              <h3 class="mt-3 font-display text-2xl font-bold uppercase tracking-tight">{e.title}</h3>
              {e.subtitle && (
                <p class="mt-2 text-sm text-offwhite/85">{e.subtitle}</p>
              )}
              {e.featuredArtists && (
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <span class="text-xs font-bold uppercase tracking-widest text-ash">Featuring</span>
                  {e.featuredArtists.map((artist) => (
                    <span class="inline-block rounded-full bg-white/5 px-3 py-1 text-xs font-semibold text-offwhite/90 backdrop-blur-sm">
                      {artist}
                    </span>
                  ))}
                </div>
              )}
              <div class="mt-3 flex flex-col gap-2 text-sm text-ash sm:flex-row sm:gap-6">
                {e.venue && (
                  <span class="inline-flex items-center gap-2">
                    <MapPin size={16} class="text-red" /> {e.venue}
                  </span>
                )}
                <span class="inline-flex items-center gap-2">
                  <Clock size={16} class="text-red" /> {e.time}
                </span>
              </div>
            </div>
            {e.status === "On sale" ? (
              <a
                href="https://events.ticketleap.com/tickets/powered-by-energy-soul/lovehouse-clt-210208621"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-red px-6 py-3 font-display text-xs font-bold uppercase tracking-widest text-offwhite transition-transform hover:scale-[1.03]"
              >
                <Ticket size={16} /> Get tickets
              </a>
            ) : (
              <a
                href="/contact"
                class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3 font-display text-xs font-bold uppercase tracking-widest text-ash transition-colors hover:border-magenta hover:text-magenta"
              >
                <BellRing size={16} /> Notify me
              </a>
            )}
          </div>
        ))
      }
    </div>

    <!-- FEATURED ARTISTS · LOVEHOUSE AUG 15 -->
    <div class="mt-20">
      <h2 class="font-display text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">
        Featured Artists · LoveHouse <span class="text-red">Aug 15</span>
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <!-- Card 1 — Resident Curator: John Crockett -->
        <div class="rounded-2xl border border-white/10 bg-ink-soft p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-magenta">Resident Curator</p>
          <img
            src="https://cdn.marblism.com/pa7gA9E2Sku.jpeg"
            alt="John Crockett"
            class="mt-4 h-60 w-full rounded-xl object-cover"
          />
          <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-tight">John Crockett</h3>
          <p class="mt-3 text-sm leading-relaxed text-ash">
            With over four decades in house music, John Crockett brings the soul of New Jersey's
            legendary club scene to Charlotte's underground. Resident Curator at LoveHouse, founder of
            Twirlspace Recordings, and curator of deep, soulful, afro tech house journeys. Catch his
            weekly shows on Twitch — TWIRLSPACE & SLEAZY MORNING DISCO (Saturdays 11pm-4am) and Wax on
            Wax Off (Tuesdays).
          </p>
        </div>

        <!-- Card 2 — Special Guest: Wil Milton -->
        <div class="rounded-2xl border border-white/10 bg-ink-soft p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-magenta">Special Guest</p>
          <img src="https://cdn.marblism.com/Wt61zS5rC-l.webp" alt="Wil Milton" class="mt-4 object-cover h-60 w-full rounded-xl" />
          <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-tight">Wil Milton</h3>
          <p class="mt-3 text-sm leading-relaxed text-ash">
            A celebrated New York–based DJ, producer, and songwriter with over 35 years in the
            industry. Wil has become a respected figure in the global house music scene, known for his
            soulful, deep, and uplifting sound that transcends boundaries. His artistry has taken him
            across the world, earning a devoted following internationally. He has worked alongside
            François Kevorkian, Lady Alma, Kenny Bobien, Louie Vega, BLAZE, Timmy Regisford, and many
            more.
          </p>
        </div>

        <!-- Card 3 — The Ember: DJ Q-INETIC -->
        <div class="rounded-2xl border border-white/10 bg-ink-soft p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-magenta">The Ember</p>
          <img src="https://cdn.marblism.com/I0JWw7LN7Vg.jpg" alt="DJ Q-INETIC" class="mt-4 object-cover h-60 w-full rounded-xl" />
          <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-tight">DJ Q-INETIC</h3>
          <p class="mt-3 text-sm leading-relaxed text-ash">
            Jersey born, Charlotte based — DJ Q-INETIC is the new spark on the scene, bringing
            energetic deep and soulful sets to the underground house music movement in the Queen City.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 rounded-3xl border border-white/10 bg-gradient-to-br from-violet/25 via-ink-soft to-crimson/30 p-10 text-center sm:p-14">
      <h2 class="font-display text-3xl font-black uppercase tracking-tight sm:text-4xl">
        Booking a DJ?
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-ash">
        Bring the LoveHouse sound to your venue, festival, or private event. Tell
        us the vibe — we'll handle the floor.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-offwhite px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-ink transition-transform hover:scale-[1.03]"
      >
        Book us
        <ArrowRight size={18} />
      </a>
    </div>
  </section>
</Layout>
