export type SocialIconName = keyof typeof ICONS;

interface Props {
  /** Which icon to render. */
  name: SocialIconName;
  /** Pixel size (number → px) or any CSS length string. Defaults to 24. */
  size?: number | string;
  /** Explicit fill. Overrides `brand`. Defaults to `currentColor`. */
  color?: string;
  /** Use the official brand colour instead of currentColor. */
  brand?: boolean;
  /** Accessible label. If omitted the icon is treated as decorative (aria-hidden). */
  title?: string;
  /** Extra class names passed through to the <svg>. */
  class?: string;
}

const {
  name,
  size = 24,
  color,
  brand = false,
  title,
  class: className,
} = Astro.props;

const icon = ICONS[name];
if (!icon) {
  throw new Error(
    `<SocialIcon>: unknown icon "${name}". Available: ${Object.keys(ICONS).join(", ")}`,
  );
}

const dimension = typeof size === "number" ? `${size}px` : size;
const fill = color ?? (brand ? icon.brand : "currentColor");
---

<svg
  viewBox="0 0 24 24"
  width={dimension}
  height={dimension}
  fill={fill}
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
>
  {title && <title>{title}</title>}
  <path d={icon.path} />
</svg>
