/**
 * SocialIcon — a self-contained brand-icon component.
 *
 * All paths are embedded, so there's no runtime dependency and no gaps:
 *   - instagram, x, android, ios, apple, facebook  → Simple Icons (CC0)
 *   - linkedin                                      → Material Design Icons
 *     (LinkedIn was removed from Simple Icons at LinkedIn's request, so it's
 *      sourced separately but normalised to the same 24×24 grid + filled style)
 *
 * Usage:
 *   <SocialIcon name="instagram" />                     // inherits currentColor
 *   <SocialIcon name="instagram" brand />               // official brand colour
 *   <SocialIcon name="x" size={32} color="#1d9bf0" />   // custom size + colour
 *   <SocialIcon name="linkedin" title="LinkedIn" />     // accessible label
