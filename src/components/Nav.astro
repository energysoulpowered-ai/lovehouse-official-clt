---
const links = [
  { href: "/", label: "Home" },
  { href: "/music", label: "Music" },
  { href: "/events", label: "Events" },
  { href: "/gallery", label: "Gallery" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-ink/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 sm:px-10"
  >
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="LoveHouse Official CLT home">
      <img
        src="/images/love-house-logo.webp"
        alt="LoveHouse Official CLT"
        width="44"
        height="44"
        class="h-11 w-11 rounded-md object-cover"
      />
      <span class="hidden font-display text-lg font-extrabold uppercase leading-none tracking-tight sm:block">
        LoveHouse<span class="text-red"> CLT</span>
      </span>
    </a>

    <ul class="flex items-center gap-1 text-sm font-semibold uppercase tracking-wide sm:gap-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "rounded-full px-3 py-2 transition-colors hover:text-red sm:px-4",
                isActive(l.href) ? "text-red" : "text-offwhite/80",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
